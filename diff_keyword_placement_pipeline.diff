+    final tokens = _sharedKeywordMatcher.tokenize(normalized);
+    if (_sharedKeywordMatcher.matchesCueSetStrict(
+      normalized: normalized,
+      tokens: tokens,
+      cues: cues,
+    )) {
+      strength += label.confidence;
+    }
+  }
+
+  return strength;
+}
