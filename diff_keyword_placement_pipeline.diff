+    if (cueSummary.animationCueCount >= 2) {
+      bonus += 0.2;
+      secondarySupport.add('strong stylized cluster');
+    }
+
+    if (cueSummary.animationCueCount > 0 &&
+        cueSummary.logoTextApparelCueCount > 0) {
