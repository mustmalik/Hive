+    derived: derived,
+  );
+
+  return summary.screenDeviceCueCount >= 2 ||
+      (summary.presentationCueCount > 0 &&
+          (hasStructuralEvidence || summary.screenDeviceCueCount > 0)) ||
+      (summary.screenDeviceCueCount > 0 && hasStructuralEvidence);
+}
